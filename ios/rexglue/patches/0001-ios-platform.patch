+#endif
+
 namespace {
 
 int RunWindowedApp(int argc, char** argv) {
@@ -127,6 +134,14 @@ int WINAPI wWinMain(HINSTANCE hinstance, HINSTANCE hinstance_prev, LPWSTR comman
 #else
 
 int main(int argc, char* argv[]) {
+#if REX_PLATFORM_IOS
+  // OpenJam: an app starts in a read-only folder; Documents is its own, and
+  // what the runtime writes relative to the current folder lands there.
+  if (const char* home = std::getenv("HOME")) {
+    std::error_code ec;
+    std::filesystem::current_path(std::filesystem::path(home) / "Documents", ec);
+  }
+#endif
   return RunWindowedApp(argc, argv);
 }
 
