diff --git a/src/core/memory_posix.cpp b/src/core/memory_posix.cpp
index b52bf39..6d1a2e1 100644
--- a/src/core/memory_posix.cpp
+++ b/src/core/memory_posix.cpp
@@ -12,6 +12,7 @@
 #include <cerrno>
 #include <cstddef>
 #include <cstdio>
+#include <cstdlib>
 #include <cstring>
 #include <fstream>
 #include <functional>
@@ -475,6 +476,18 @@ FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, siz
   oflag |= O_CREAT;
   auto full_path = MakeShmName(path);
   int ret = shm_open(full_path.c_str(), oflag, 0777);
+#if REX_PLATFORM_IOS
+  if (ret < 0) {
+    // OpenJam: the iOS sandbox refuses shm_open. An unlinked file in the
+    // app's temporary folder maps the same way and is sparse until written.
+    const char* tmp = std::getenv("TMPDIR");
+    std::string file = std::string(tmp && *tmp ? tmp : "/tmp/") + "/rex" + full_path.substr(1);
+    ret = open(file.c_str(), O_RDWR | O_CREAT | O_TRUNC, 0600);
+    if (ret >= 0) {
+      unlink(file.c_str());
+    }
+  }
+#endif
   if (ret < 0) {
     return kFileMappingHandleInvalid;
   }
