<?xml version="1.0" encoding="utf-8"?>
<!-- The game, as an Xbox One app. See xbox/game/package.ps1. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap">

  <Identity
    Name="OpenJam.NBAJamOFE"
    Publisher="CN=OpenJam"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>NBA JAM: On Fire Edition</DisplayName>
    <PublisherDisplayName>OpenJam</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17134 (April 2018) is the first with VirtualAlloc2FromApp and
         MapViewOfFile3FromApp, which the guest memory arena is built with. -->
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17134.0" MaxVersionTested="10.0.22621.0" />
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17134.0" MaxVersionTested="10.0.22621.0" />
    <!-- No VCLibs: the game is ordinary Windows code, and carries the desktop
         C++ runtime DLLs inside the package. -->
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="nbajam_ofe.exe" EntryPoint="OpenJam.App">
      <uap:VisualElements
        DisplayName="NBA JAM: On Fire Edition"
        Description="NBA JAM: On Fire Edition, recompiled. Bring your own copy of the game."
        BackgroundColor="#000000"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000" />
      </uap:VisualElements>
    </Application>
    <!-- The smoke test, built like the game, as a second tile: it loads the
         game's DLLs one by one and writes report.txt into this package's
         LocalState, for when the game itself closes before it can say why. -->
    <Application Id="Diagnostics" Executable="smoketest.exe" EntryPoint="OpenJam.Diagnostics">
      <uap:VisualElements
        DisplayName="NBA JAM Diagnostics"
        Description="Checks why NBA JAM will not start"
        BackgroundColor="#000000"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
