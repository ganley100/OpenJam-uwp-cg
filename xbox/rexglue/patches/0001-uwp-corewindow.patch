diff --git a/include/rex/ui/surface_winrt.h b/include/rex/ui/surface_winrt.h
new file mode 100644
index 0000000..1365d85
--- /dev/null
+++ b/include/rex/ui/surface_winrt.h
@@ -0,0 +1,37 @@
+/**
+ * @file        ui/surface_winrt.h
+ * @brief       A UWP CoreWindow as a presentation surface (Xbox One)
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP).
+ */
+
+#pragma once
+
+#include <unknwn.h>
+
+#include <rex/ui/surface.h>
+
+namespace rex::ui {
+
+class Window;
+
+// The CoreWindow is held as its ABI IUnknown, so nothing that includes this
+// needs C++/WinRT. The size comes from the Window, which tracks it from the
+// CoreWindow's own events.
+class WinRTCoreWindowSurface final : public Surface {
+ public:
+  WinRTCoreWindowSurface(::IUnknown* core_window, const Window* window);
+  ~WinRTCoreWindowSurface() override;
+
+  TypeIndex GetType() const override { return kTypeIndex_WinRTCoreWindow; }
+  ::IUnknown* core_window() const { return core_window_; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override;
+
+ private:
+  ::IUnknown* core_window_;
+  const Window* window_;
+};
+
+}  // namespace rex::ui
diff --git a/include/rex/ui/window_uwp.h b/include/rex/ui/window_uwp.h
new file mode 100644
index 0000000..3d7f868
--- /dev/null
+++ b/include/rex/ui/window_uwp.h
@@ -0,0 +1,57 @@
+/**
+ * @file        ui/window_uwp.h
+ * @brief       UWP (CoreWindow) implementation of the Window abstraction
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP), standing in for
+ *              WindowSDL.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string_view>
+
+#include <rex/ui/window.h>
+#include <rex/ui/windowed_app_context_uwp.h>
+
+namespace rex::ui {
+
+// The app's one CoreWindow. It is always full screen and cannot be closed by
+// the app, only by the system, so most of what a desktop window does is
+// absent here.
+class WindowUWP final : public Window {
+ public:
+  WindowUWP(WindowedAppContext& app_context, const std::string_view title,
+            uint32_t desired_logical_width, uint32_t desired_logical_height);
+  ~WindowUWP() override;
+
+ protected:
+  uint32_t GetLatestDpiImpl() const override;
+
+  bool OpenImpl() override;
+  void RequestCloseImpl() override;
+
+  std::unique_ptr<Surface> CreateSurfaceImpl(Surface::TypeFlags allowed_types) override;
+  void RequestPaintImpl() override;
+
+ private:
+  struct Impl;
+
+  UWPWindowedAppContext& uwp_app_context() const {
+    return static_cast<UWPWindowedAppContext&>(app_context());
+  }
+
+  void UpdateSize();
+  void HandlePaint();
+  void HandleClosed();
+  void PerformClose();
+  void Detach();
+
+  std::unique_ptr<Impl> impl_;
+  std::atomic<bool> paint_pending_{false};
+  uint32_t dpi_ = 96;
+};
+
+}  // namespace rex::ui
diff --git a/include/rex/ui/windowed_app_context_uwp.h b/include/rex/ui/windowed_app_context_uwp.h
new file mode 100644
index 0000000..6eee393
--- /dev/null
+++ b/include/rex/ui/windowed_app_context_uwp.h
@@ -0,0 +1,41 @@
+/**
+ * @file        ui/windowed_app_context_uwp.h
+ * @brief       UWP (CoreWindow) implementation of the windowed app UI loop
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP), standing in for
+ *              SDLWindowedAppContext. SDL3 has no UWP support.
+ */
+
+#pragma once
+
+#include <memory>
+
+#include <unknwn.h>
+
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex::ui {
+
+// One CoreWindow, the one CoreApplication gives the app. The UI thread is the
+// CoreWindow's thread, and pending functions reach it through its dispatcher.
+class UWPWindowedAppContext final : public WindowedAppContext {
+ public:
+  // `core_window` is the ABI pointer of the app's CoreWindow.
+  explicit UWPWindowedAppContext(::IUnknown* core_window);
+  ~UWPWindowedAppContext() override;
+
+  void NotifyUILoopOfPendingFunctions() override;
+  void PlatformQuitFromUIThread() override;
+
+  int RunMainMessageLoop();
+
+  ::IUnknown* core_window() const { return core_window_; }
+
+  // Runs `function` on the UI thread from the dispatcher, from any thread.
+  void PostToUIThread(void (*function)(void*), void* data);
+
+ private:
+  ::IUnknown* core_window_;
+};
+
+}  // namespace rex::ui
