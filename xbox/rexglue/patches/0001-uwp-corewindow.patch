new file mode 100644
index 0000000..65b9e40
--- /dev/null
+++ b/src/ui/windowed_app_main_uwp.cpp
@@ -0,0 +1,77 @@
+/**
+ * @file        ui/windowed_app_main_uwp.cpp
+ * @brief       Entry point for windowed applications as a UWP app (Xbox One)
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP), standing in for
+ *              windowed_app_main_sdl.cpp. Compiled into the host executable.
+ */
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+#include <cstdlib>
+#include <map>
+#include <memory>
+#include <string>
+
+#include <winrt/Windows.ApplicationModel.Core.h>
+#include <winrt/Windows.Foundation.h>
+#include <winrt/Windows.UI.Core.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_uwp.h>
+
+namespace {
+
+using namespace winrt::Windows::ApplicationModel::Core;
+using winrt::Windows::UI::Core::CoreWindow;
+
+// An app has no command line. Everything that would be passed on one comes
+// from the app's own defaults (ReXApp::OnPreSetup) or a config file.
+int RunWindowedApp(::IUnknown* core_window) {
+  char arg0[] = "app";
+  char* argv[] = {arg0, nullptr};
+  rex::cvar::Init(1, argv);
+  rex::cvar::ApplyEnvironment();
+  rex::InitLoggingEarly();
+
+  int result;
+  {
+    rex::ui::UWPWindowedAppContext app_context(core_window);
+    std::unique_ptr<rex::ui::WindowedApp> app = rex::ui::GetWindowedAppCreator()(app_context);
+    app->SetParsedArguments(std::map<std::string, std::string>{});
+    result = app->OnInitialize() ? app_context.RunMainMessageLoop() : EXIT_FAILURE;
+    app->InvokeOnDestroy();
+  }
+  return result;
+}
+
+struct View : winrt::implements<View, IFrameworkViewSource, IFrameworkView> {
+  IFrameworkView CreateView() { return *this; }
+  void Initialize(CoreApplicationView const&) {}
+  void Load(winrt::hstring const&) {}
+  void Uninitialize() {}
+  void SetWindow(CoreWindow const& window) { window_ = window; }
+
+  void Run() {
+    window_.Activate();
+    RunWindowedApp(static_cast<::IUnknown*>(winrt::get_abi(window_)));
+    // Leaving Run ends the app.
+  }
+
+  CoreWindow window_{nullptr};
+};
+
+}  // namespace
+
+int WINAPI wWinMain(HINSTANCE, HINSTANCE, LPWSTR, int) {
+  CoreApplication::Run(winrt::make<View>());
+  return 0;
+}
