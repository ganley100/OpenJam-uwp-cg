diff --git a/src/ui/surface_winrt.cpp b/src/ui/surface_winrt.cpp
new file mode 100644
index 0000000..52dda49
--- /dev/null
+++ b/src/ui/surface_winrt.cpp
@@ -0,0 +1,33 @@
+/**
+ * @file        ui/surface_winrt.cpp
+ * @brief       A UWP CoreWindow as a presentation surface (Xbox One)
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP).
+ */
+
+#include <rex/ui/surface_winrt.h>
+
+#include <rex/ui/window.h>
+
+namespace rex::ui {
+
+WinRTCoreWindowSurface::WinRTCoreWindowSurface(::IUnknown* core_window, const Window* window)
+    : core_window_(core_window), window_(window) {
+  if (core_window_) {
+    core_window_->AddRef();
+  }
+}
+
+WinRTCoreWindowSurface::~WinRTCoreWindowSurface() {
+  if (core_window_) {
+    core_window_->Release();
+  }
+}
+
+bool WinRTCoreWindowSurface::GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const {
+  width_out = window_->GetActualPhysicalWidth();
+  height_out = window_->GetActualPhysicalHeight();
+  return width_out && height_out;
+}
+
+}  // namespace rex::ui
diff --git a/src/ui/window_uwp.cpp b/src/ui/window_uwp.cpp
new file mode 100644
index 0000000..ff4b1a9
--- /dev/null
+++ b/src/ui/window_uwp.cpp
@@ -0,0 +1,167 @@
+/**
+ * @file        ui/window_uwp.cpp
+ * @brief       UWP (CoreWindow) implementation of the Window abstraction
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP).
+ */
+
+#include <rex/ui/window_uwp.h>
+
+#include <cmath>
+
+#include <winrt/Windows.Foundation.h>
+#include <winrt/Windows.Graphics.Display.h>
+#include <winrt/Windows.System.h>
+#include <winrt/Windows.UI.Core.h>
+
+#include <rex/logging.h>
+#include <rex/ui/surface_winrt.h>
+
+namespace rex::ui {
+
+using winrt::Windows::Graphics::Display::DisplayInformation;
+using winrt::Windows::UI::Core::CoreWindow;
+
+struct WindowUWP::Impl {
+  CoreWindow window{nullptr};
+  winrt::event_token size_changed{};
+  winrt::event_token activated{};
+  winrt::event_token closed{};
+  winrt::event_token key_down{};
+  winrt::event_token key_up{};
+  double pixels_per_dip = 1.0;
+};
+
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                       const std::string_view title, uint32_t desired_logical_width,
+                                       uint32_t desired_logical_height) {
+  return std::make_unique<WindowUWP>(app_context, title, desired_logical_width,
+                                     desired_logical_height);
+}
+
+WindowUWP::WindowUWP(WindowedAppContext& app_context, const std::string_view title,
+                     uint32_t desired_logical_width, uint32_t desired_logical_height)
+    : Window(app_context, title, desired_logical_width, desired_logical_height),
+      impl_(std::make_unique<Impl>()) {}
+
+WindowUWP::~WindowUWP() {
+  EnterDestructor();
+  Detach();
+}
+
+uint32_t WindowUWP::GetLatestDpiImpl() const {
+  return dpi_;
+}
+
+bool WindowUWP::OpenImpl() {
+  winrt::copy_from_abi(impl_->window, uwp_app_context().core_window());
+  try {
+    // Must be asked on the UI thread, which this is.
+    auto display = DisplayInformation::GetForCurrentView();
+    impl_->pixels_per_dip = display.RawPixelsPerViewPixel();
+    dpi_ = uint32_t(std::lround(display.LogicalDpi()));
+  } catch (const winrt::hresult_error&) {
+    impl_->pixels_per_dip = 1.0;
+  }
+  if (impl_->pixels_per_dip <= 0.0) {
+    impl_->pixels_per_dip = 1.0;
+  }
+
+  impl_->size_changed = impl_->window.SizeChanged([this](auto&&, auto&&) { UpdateSize(); });
+  impl_->activated = impl_->window.Activated([this](auto&&, auto&& args) {
+    WindowDestructionReceiver destruction_receiver(this);
+    OnFocusUpdate(args.WindowActivationState() !=
+                      winrt::Windows::UI::Core::CoreWindowActivationState::Deactivated,
+                  destruction_receiver);
+  });
+  impl_->closed = impl_->window.Closed([this](auto&&, auto&&) { HandleClosed(); });
+  // Keys, for the debug overlays; a controller arrives through XInput.
+  auto key = [this](bool down, winrt::Windows::UI::Core::KeyEventArgs const& args) {
+    const auto status = args.KeyStatus();
+    KeyEvent e(this, VirtualKey(uint16_t(args.VirtualKey())), int(status.RepeatCount),
+               status.WasKeyDown, false, false, status.IsMenuKeyDown, false);
+    WindowDestructionReceiver destruction_receiver(this);
+    if (down) {
+      OnKeyDown(e, destruction_receiver);
+    } else {
+      OnKeyUp(e, destruction_receiver);
+    }
+  };
+  impl_->key_down = impl_->window.KeyDown([key](auto&&, auto&& args) { key(true, args); });
+  impl_->key_up = impl_->window.KeyUp([key](auto&&, auto&& args) { key(false, args); });
+
+  WindowDestructionReceiver destruction_receiver(this);
+  UpdateSize();
+  OnFocusUpdate(true, destruction_receiver);
+  REXLOG_INFO("WindowUWP: CoreWindow {}x{} physical, {} DPI", GetActualPhysicalWidth(),
+              GetActualPhysicalHeight(), dpi_);
+  return true;
+}
+
+void WindowUWP::UpdateSize() {
+  if (!impl_->window) {
+    return;
+  }
+  const auto bounds = impl_->window.Bounds();
+  const uint32_t width = uint32_t(std::lround(bounds.Width * impl_->pixels_per_dip));
+  const uint32_t height = uint32_t(std::lround(bounds.Height * impl_->pixels_per_dip));
+  WindowDestructionReceiver destruction_receiver(this);
+  OnActualSizeUpdate(width, height, destruction_receiver);
+}
+
+void WindowUWP::Detach() {
+  if (!impl_->window) {
+    return;
+  }
+  impl_->window.SizeChanged(impl_->size_changed);
+  impl_->window.Activated(impl_->activated);
+  impl_->window.Closed(impl_->closed);
+  impl_->window.KeyDown(impl_->key_down);
+  impl_->window.KeyUp(impl_->key_up);
+  impl_->window = nullptr;
+}
+
+void WindowUWP::HandleClosed() {
+  // The system is closing the app; there is no veto.
+  PerformClose();
+}
+
+void WindowUWP::RequestCloseImpl() {
+  // An app cannot close its CoreWindow. Closing ends the message loop, and
+  // the process ends when CoreApplication's Run returns.
+  PerformClose();
+}
+
+void WindowUWP::PerformClose() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+  Detach();
+  OnAfterClose();
+}
+
+std::unique_ptr<Surface> WindowUWP::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  if (!impl_->window || !(allowed_types & Surface::kTypeFlag_WinRTCoreWindow)) {
+    return nullptr;
+  }
+  return std::make_unique<WinRTCoreWindowSurface>(
+      static_cast<::IUnknown*>(winrt::get_abi(impl_->window)), this);
+}
+
+void WindowUWP::RequestPaintImpl() {
+  // At most one paint queued at a time; callable from any thread.
+  if (paint_pending_.exchange(true, std::memory_order_acq_rel)) {
+    return;
+  }
+  uwp_app_context().PostToUIThread(
+      [](void* self) { static_cast<WindowUWP*>(self)->HandlePaint(); }, this);
+}
+
+void WindowUWP::HandlePaint() {
+  paint_pending_.store(false, std::memory_order_release);
+  OnPaint();
+}
+
+}  // namespace rex::ui
diff --git a/src/ui/windowed_app_context_uwp.cpp b/src/ui/windowed_app_context_uwp.cpp
new file mode 100644
index 0000000..0717920
--- /dev/null
+++ b/src/ui/windowed_app_context_uwp.cpp
@@ -0,0 +1,76 @@
+/**
+ * @file        ui/windowed_app_context_uwp.cpp
+ * @brief       UWP (CoreWindow) implementation of the windowed app UI loop
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP).
+ */
+
+#include <rex/ui/windowed_app_context_uwp.h>
+
+#include <cstdlib>
+
+#include <winrt/Windows.Foundation.h>
+#include <winrt/Windows.UI.Core.h>
+
+#include <rex/logging.h>
+
+namespace rex::ui {
+
+namespace {
+
+winrt::Windows::UI::Core::CoreWindow AsCoreWindow(::IUnknown* abi) {
+  winrt::Windows::UI::Core::CoreWindow window{nullptr};
+  winrt::copy_from_abi(window, abi);
+  return window;
+}
+
+}  // namespace
+
+UWPWindowedAppContext::UWPWindowedAppContext(::IUnknown* core_window)
+    : core_window_(core_window) {
+  core_window_->AddRef();
+}
+
+UWPWindowedAppContext::~UWPWindowedAppContext() {
+  // Leftover pending functions run before the loop machinery goes away, as
+  // the WindowedAppContext shutdown contract asks.
+  ExecutePendingFunctionsFromUIThread();
+  core_window_->Release();
+}
+
+void UWPWindowedAppContext::PostToUIThread(void (*function)(void*), void* data) {
+  try {
+    AsCoreWindow(core_window_)
+        .Dispatcher()
+        .RunAsync(winrt::Windows::UI::Core::CoreDispatcherPriority::Normal,
+                  [function, data]() { function(data); });
+  } catch (const winrt::hresult_error& e) {
+    REXLOG_ERROR("UWPWindowedAppContext: RunAsync failed: {:08X}", uint32_t(e.code().value));
+  }
+}
+
+void UWPWindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  // Thread-safe by the dispatcher's contract; wakes ProcessEvents below.
+  PostToUIThread(
+      [](void* self) {
+        static_cast<UWPWindowedAppContext*>(self)->ExecutePendingFunctionsFromUIThread();
+      },
+      this);
+}
+
+void UWPWindowedAppContext::PlatformQuitFromUIThread() {
+  // RunMainMessageLoop re-checks HasQuitFromUIThread after each wake.
+  NotifyUILoopOfPendingFunctions();
+}
+
+int UWPWindowedAppContext::RunMainMessageLoop() {
+  auto dispatcher = AsCoreWindow(core_window_).Dispatcher();
+  while (!HasQuitFromUIThread()) {
+    // Blocks until there is at least one event, then drains the queue.
+    dispatcher.ProcessEvents(
+        winrt::Windows::UI::Core::CoreProcessEventsOption::ProcessOneAndAllPending);
+  }
+  return EXIT_SUCCESS;
+}
+
+}  // namespace rex::ui
