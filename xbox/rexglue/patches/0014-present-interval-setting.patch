+  // OpenJam: the console has no monitor whose vertical blank the UI tick
+  // could pace this by; see the settings above for what it does instead.
+  if (const int32_t fps = REXCVAR_GET(present_fps_limit); fps > 0) {
+    using clock = std::chrono::steady_clock;
+    static clock::time_point next{};
+    const auto period = std::chrono::nanoseconds(1000000000LL / fps);
+    const auto now = clock::now();
+    if (next != clock::time_point{} && now < next) {
+      // A high-resolution timer: the ordinary sleep is good to ~15 ms.
+      static HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, 0x00000002, TIMER_ALL_ACCESS);
+      const auto left = next - now;
+      if (timer && left > std::chrono::microseconds(500)) {
+        LARGE_INTEGER due;
+        due.QuadPart = -std::chrono::duration_cast<std::chrono::nanoseconds>(left).count() / 100;
+        if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) {
+          WaitForSingleObject(timer, INFINITE);
+        }
+      }
+      while (clock::now() < next) std::this_thread::yield();
+      next += period;
+    } else {
+      next = now + period;
+    }
+  }
+  const int32_t interval = std::clamp(REXCVAR_GET(present_interval), 0, 4);
+  HRESULT present_result =
+      interval > 0
+          ? paint_context_.swap_chain->Present(UINT(interval), 0)
+          : paint_context_.swap_chain->Present(
+                0, DXGI_PRESENT_RESTART | (paint_context_.swap_chain_allows_tearing
+                                               ? DXGI_PRESENT_ALLOW_TEARING
+                                               : 0));
