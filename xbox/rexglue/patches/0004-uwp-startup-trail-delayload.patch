+// A trail of how far startup got, in LocalState\startup.txt, and what killed
+// it if something did. On a console there is no other way to tell: an app that
+// dies early leaves no log and no dialog, only a splash screen that closes.
+std::filesystem::path g_trail;
+
+void Trail(const char* text) {
+  if (g_trail.empty()) {
+    return;
+  }
+  std::ofstream f(g_trail, std::ios::app);
+  f << text << "\n";
+}
+
+LONG WINAPI RecordCrash(EXCEPTION_POINTERS* info) {
+  const auto* rec = info->ExceptionRecord;
+  char module_name[MAX_PATH] = "?";
+  HMODULE module = nullptr;
+  uintptr_t offset = 0;
+  if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                             GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         static_cast<LPCSTR>(rec->ExceptionAddress), &module) &&
+      module) {
+    GetModuleFileNameA(module, module_name, MAX_PATH);
+    offset = reinterpret_cast<uintptr_t>(rec->ExceptionAddress) - reinterpret_cast<uintptr_t>(module);
+  }
+  char line[512];
+  // 0xC06D007E is a delay-loaded DLL that is not on the console; its name is
+  // in the delay-load record.
+  std::snprintf(line, sizeof(line), "CRASH: exception %08lX at %s+0x%llX",
+                static_cast<unsigned long>(rec->ExceptionCode), module_name,
+                static_cast<unsigned long long>(offset));
+  Trail(line);
+  if (rec->ExceptionCode == 0xC06D007E && rec->NumberParameters >= 1) {
+    // DelayLoadInfo: its szDll is the second pointer-sized field after cb.
+    struct Info {
+      DWORD cb;
+      const void* pidd;
+      const void** ppfn;
+      LPCSTR szDll;
+    };
+    const auto* dli = reinterpret_cast<const Info*>(rec->ExceptionInformation[0]);
+    if (dli && dli->szDll) {
+      std::snprintf(line, sizeof(line), "CRASH: missing DLL %s", dli->szDll);
+      Trail(line);
+    }
+  }
+  return EXCEPTION_CONTINUE_SEARCH;
+}
