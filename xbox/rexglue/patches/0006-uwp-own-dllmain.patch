+/**
+ * @file        core/uwp_dllmain.cpp
+ * @brief       The runtime DLL's own DllMain, for the UWP build
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP). The CRT's DLL
+ *              entry calls a function named DllMain once the module is
+ *              initialized, and falls back to an empty one from the CRT when
+ *              the module has none. But xinputuap.lib - which a UWP build
+ *              links for XInput - exports a DllMain of its own from
+ *              XINPUTUAP.dll, and the linker found that first. The runtime
+ *              then called XINPUTUAP's DllMain as its own on every load: a
+ *              fast fail on a PC and the app closing on the Xbox. Defining it
+ *              here keeps the linker from looking for one in the libraries.
+ */
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+extern "C" BOOL WINAPI DllMain(HINSTANCE, DWORD, LPVOID) {
+  return TRUE;
+}
