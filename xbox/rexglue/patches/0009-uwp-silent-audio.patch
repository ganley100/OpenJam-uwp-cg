--- /dev/null
+++ b/include/rex/audio/silent/silent_audio_system.h
@@ -0,0 +1,35 @@
+/**
+ * @file        audio/silent/silent_audio_system.h
+ * @brief       An audio backend that plays nothing, in real time
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP), which has no
+ *              SDL3. Unlike the nop backend, which refuses to create a driver,
+ *              this accepts every frame the guest submits and consumes it at
+ *              the rate a real device would - 256 samples at 48 kHz - so a
+ *              title's audio engine runs as it would with sound. NBA JAM does
+ *              not survive the refusal: its audio engine is left half built,
+ *              and a streaming thread calls into it and hits a pure virtual
+ *              call.
+ */
+
+#pragma once
+
+#include <rex/audio/audio_system.h>
+
+namespace rex::audio::silent {
+
+class SilentAudioSystem : public AudioSystem {
+ public:
+  explicit SilentAudioSystem(runtime::FunctionDispatcher* function_dispatcher);
+  ~SilentAudioSystem() override;
+
+  static bool IsAvailable() { return true; }
+
+  static std::unique_ptr<AudioSystem> Create(runtime::FunctionDispatcher* function_dispatcher);
+
+  X_STATUS CreateDriver(size_t index, rex::thread::Semaphore* semaphore,
+                        AudioDriver** out_driver) override;
+  void DestroyDriver(AudioDriver* driver) override;
+};
+
+}  // namespace rex::audio::silent
