@@ -0,0 +1,90 @@
+/**
+ * @file        audio/silent/silent_audio_system.cpp
+ * @brief       An audio backend that plays nothing, in real time
+ *
+ * @remarks     OpenJam patch for the UWP build (REXGLUE_UWP). See the header.
+ */
+
+#include <rex/audio/silent/silent_audio_system.h>
+
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+#include <rex/audio/audio_driver.h>
+#include <rex/thread.h>
+
+namespace rex::audio::silent {
+
+namespace {
+
+// Consumes submitted frames at the rate a device would play them, and for
+// each one tells the audio system it may ask the guest for another - which is
+// all a real driver's callback does besides playing it.
+class SilentAudioDriver : public AudioDriver {
+ public:
+  SilentAudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+      : AudioDriver(memory), semaphore_(semaphore), thread_([this] { Run(); }) {}
+
+  ~SilentAudioDriver() override {
+    running_ = false;
+    if (thread_.joinable()) {
+      thread_.join();
+    }
+  }
+
+  void SubmitFrame(uint32_t /*samples_ptr*/) override { pending_.fetch_add(1); }
+
+ private:
+  // 256 samples per channel at 48 kHz.
+  static constexpr std::chrono::microseconds kFrame{5333};
+
+  void Run() {
+    auto next = std::chrono::steady_clock::now();
+    while (running_) {
+      next += kFrame;
+      std::this_thread::sleep_until(next);
+      // Fallen far behind (a suspend, a debugger): start again from now
+      // rather than releasing a burst.
+      const auto now = std::chrono::steady_clock::now();
+      if (now - next > kFrame * 32) {
+        next = now;
+      }
+      int pending = pending_.load();
+      while (pending > 0 && !pending_.compare_exchange_weak(pending, pending - 1)) {
+      }
+      if (pending > 0) {
+        semaphore_->Release(1, nullptr);
+      }
+    }
+  }
+
+  rex::thread::Semaphore* semaphore_;
+  std::atomic<int> pending_{0};
+  std::atomic<bool> running_{true};
+  std::thread thread_;
+};
+
+}  // namespace
+
+std::unique_ptr<AudioSystem> SilentAudioSystem::Create(
+    runtime::FunctionDispatcher* function_dispatcher) {
+  return std::make_unique<SilentAudioSystem>(function_dispatcher);
+}
+
+SilentAudioSystem::SilentAudioSystem(runtime::FunctionDispatcher* function_dispatcher)
+    : AudioSystem(function_dispatcher) {}
+
+SilentAudioSystem::~SilentAudioSystem() = default;
+
+X_STATUS SilentAudioSystem::CreateDriver(size_t /*index*/, rex::thread::Semaphore* semaphore,
+                                         AudioDriver** out_driver) {
+  *out_driver = new SilentAudioDriver(memory_, semaphore);
+  return X_STATUS_SUCCESS;
+}
+
+void SilentAudioSystem::DestroyDriver(AudioDriver* driver) {
+  delete driver;
+}
+
+}  // namespace rex::audio::silent
