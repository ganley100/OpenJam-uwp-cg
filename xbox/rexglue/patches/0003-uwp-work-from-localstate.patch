@@ -36,6 +38,14 @@ using winrt::Windows::UI::Core::CoreWindow;
 // An app has no command line. Everything that would be passed on one comes
 // from the app's own defaults (ReXApp::OnPreSetup) or a config file.
 int RunWindowedApp(::IUnknown* core_window) {
+  // An app starts in its install folder, which is read-only, and the runtime
+  // makes its logs folder in the current one. Work from LocalState instead,
+  // so logs (and anything else written relative) land somewhere writable.
+  try {
+    std::filesystem::current_path(std::filesystem::path(std::wstring(
+        winrt::Windows::Storage::ApplicationData::Current().LocalFolder().Path())));
+  } catch (...) {
+  }
   char arg0[] = "app";
   char* argv[] = {arg0, nullptr};
   rex::cvar::Init(1, argv);
