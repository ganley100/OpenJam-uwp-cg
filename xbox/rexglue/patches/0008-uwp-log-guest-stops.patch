 namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
 
+#if REXGLUE_UWP
+// OpenJam: on the console nothing is attached to catch a break, so the game
+// simply closes. Say what stopped it, from where, and flush the log first.
+// The native frames are recompiled guest functions (sub_<address>) in the
+// host executable; its linker map names them.
+void LogGuestStop(const std::string& what) {
+  std::string trace;
+  void* frames[16]{};
+  const USHORT n = RtlCaptureStackBackTrace(1, 16, frames, nullptr);
+  for (USHORT i = 0; i < n; ++i) {
+    HMODULE module = nullptr;
+    char name[MAX_PATH] = "?";
+    uintptr_t offset = 0;
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           static_cast<LPCSTR>(frames[i]), &module) &&
+        module) {
+      GetModuleFileNameA(module, name, MAX_PATH);
+      offset = reinterpret_cast<uintptr_t>(frames[i]) - reinterpret_cast<uintptr_t>(module);
+    }
+    const char* base = strrchr(name, '\\');
+    trace += fmt::format(" {}+0x{:X}", base ? base + 1 : name, offset);
+  }
+  uint32_t lr = 0;
+  if (auto* ts = rex::runtime::ThreadState::Get()) {
+    lr = uint32_t(ts->context()->lr);
+  }
+  REXKRNL_ERROR("GUEST STOP: {} (guest lr {:08X}); native stack:{}", what, lr, trace);
+  rex::FlushLogging();
+}
+#endif
+
 void DbgBreakPoint_entry() {
+#if REXGLUE_UWP
+  // A break with no debugger to take it is an assertion the game would have
+  // carried on from on a retail console. Log it and carry on.
+  LogGuestStop("DbgBreakPoint (continuing)");
+  if (!rex::debug::IsDebuggerAttached()) {
+    return;
+  }
+#endif
   rex::debug::Break();
 }
 
