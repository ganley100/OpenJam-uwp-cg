+// OpenJam: how long the GPU translation thread has spent waiting for the
+// host GPU, for the frame rate report in the host app - a lot of it means
+// the GPU, not the CPU, is what holds frames back.
+static std::atomic<uint64_t> g_openjam_gpu_wait_ns{0};
+// Exported: this is the GPU plugin, which the app finds at run time.
+extern "C" __declspec(dllexport) uint64_t OpenJamGpuWaitNs() {
+  return g_openjam_gpu_wait_ns.load(std::memory_order_relaxed);
+}
+namespace {
+void OpenJamTimedWait(HANDLE event) {
+  const auto start = std::chrono::steady_clock::now();
+  WaitForSingleObject(event, INFINITE);
+  g_openjam_gpu_wait_ns.fetch_add(
+      uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                   std::chrono::steady_clock::now() - start)
+                   .count()),
+      std::memory_order_relaxed);
+}
+}  // namespace
